{
  "nodes": [
    {
      "id": "failure-detected",
      "type": "text",
      "text": "Failure Detected",
      "x": 100,
      "y": 50,
      "width": 200,
      "height": 100,
      "color": "#F44336",
      "pv": {
        "status": "draft",
        "event": {
          "name": "actor.failure.detected",
          "attributes": {
            "actor.id": {
              "type": "string",
              "description": "The failing actor ID",
              "required": true
            },
            "actor.pid": {
              "type": "string",
              "description": "The failing actor PID",
              "required": true
            },
            "failure.reason": {
              "type": "string",
              "description": "The failure reason/error message",
              "required": true
            },
            "failure.message": {
              "type": "string",
              "description": "The message being processed when failure occurred",
              "required": false
            }
          }
        },
        "references": ["actor/actor_context.go"],
        "otel": {
          "kind": "event",
          "category": "error"
        }
      }
    },
    {
      "id": "mailbox-suspended",
      "type": "text",

      "fromSide": "bottom",
      "toSide": "top",
      "label": "Restart",
      "pv": { "edgeType": "flow" }
    },
    {
      "id": "decision-to-stopped",
      "fromNode": "supervision-decision",
      "toNode": "actor-stopped",
      "fromSide": "right",
      "toSide": "left",
      "label": "Stop",
      "pv": { "edgeType": "stop" }
    },
    {
      "id": "decision-to-resumed",
      "fromNode": "supervision-decision",
      "toNode": "actor-resumed",
      "fromSide": "right",
      "toSide": "left",
      "label": "Resume",
      "pv": { "edgeType": "success" }
    },
    {
      "id": "restart-to-children",
      "fromNode": "restart-started",
      "toNode": "children-stopped",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": { "edgeType": "flow" }
    },
    {
      "id": "children-to-complete",
      "fromNode": "children-stopped",
      "toNode": "restart-complete",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": { "edgeType": "flow" }
    }
  ],
  "pv": {
    "name": "Actor Restart & Supervision",
    "version": "1.0.0",
    "markdown": ".principal-views/actor-restart/actor-restart.md",
    "edgeTypes": {

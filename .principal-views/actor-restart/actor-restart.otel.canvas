      "pv": {
        "status": "draft",
        "event": {
          "name": "actor.supervision.decision",
          "attributes": {
            "actor.pid": {
              "type": "string",
              "description": "The failing actor PID",
              "required": true
            },
            "supervisor.pid": {
              "type": "string",
              "description": "The supervisor actor PID",
              "required": true
            },
            "strategy.type": {
              "type": "string",
              "description": "Supervision strategy type (OneForOne, AllForOne, etc.)",
              "required": true
            },
            "directive": {
              "type": "string",
              "description": "The directive decision (Resume, Restart, Stop, Escalate)",
              "required": true
            },
            "restart.count": {
              "type": "integer",
              "description": "Number of restarts within the window",
              "required": false
            }
          }
        },
        "references": ["actor/supervision.go", "actor/strategy_one_for_one.go"],
        "otel": {
          "kind": "event",
          "category": "lifecycle"
        }
      }
    },

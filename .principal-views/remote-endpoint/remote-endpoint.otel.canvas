              "required": true
            },
            "cached": {
              "type": "boolean",
              "description": "Whether endpoint was already cached",
              "required": true
            }
          }
        },
        "references": ["remote/endpoint_manager.go"],
        "otel": {
          "kind": "event",
          "category": "lifecycle"
        }
      }
    },

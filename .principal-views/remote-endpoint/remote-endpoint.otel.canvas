              "type": "string",
              "description": "The remote address",
              "required": true
            },
            "error.type": {
              "type": "string",
              "description": "Type of connection error",
              "required": true
            },
            "error.message": {
              "type": "string",
              "description": "Error message",
              "required": true
            },
            "retry.attempt": {
              "type": "integer",
              "description": "Retry attempt when error occurred",
              "required": false
            }
          }
        },
        "references": ["remote/endpoint_writer.go"],
        "otel": {
          "kind": "event",
          "category": "error"
        }

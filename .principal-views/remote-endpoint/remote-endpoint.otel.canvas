            "remote.address": {
              "type": "string",
              "description": "The terminated remote address",
              "required": true
            },
            "reason": {
              "type": "string",
              "description": "Reason for termination",
              "required": false
            }
          }
        },
        "references": ["remote/endpoint_manager.go"],
        "otel": {
          "kind": "event",

{
  "nodes": [
    {
      "id": "connect-started",
      "type": "text",
      "text": "Connection Started",
      "x": 100,
      "y": 50,
      "width": 200,
      "height": 100,
      "color": "#2196F3",
      "pv": {
        "status": "draft",
        "event": {
          "name": "remote.endpoint.connect.started",
          "attributes": {
            "remote.address": {
              "type": "string",
              "description": "The remote address being connected to",
              "required": true
            },
            "local.address": {
              "type": "string",
              "description": "The local actor system address",
              "required": false
            }
          }
        },
        "references": ["remote/endpoint_manager.go"],
        "otel": {
          "kind": "event",
          "category": "lifecycle"
        }
      }
    },
    {

  "edges": [
    {
      "id": "started-to-lazy",
      "fromNode": "connect-started",
      "toNode": "lazy-triggered",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": { "edgeType": "flow" }
    },
    {
      "id": "lazy-to-supervisor",
      "fromNode": "lazy-triggered",
      "toNode": "supervisor-request",
      "fromSide": "bottom",
      "toSide": "top",

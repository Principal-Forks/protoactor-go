    },
    {
      "id": "spawned-to-grpc",
      "fromNode": "actors-spawned",
      "toNode": "grpc-connecting",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": { "edgeType": "flow" }
    },
    {
      "id": "grpc-to-complete",
      "fromNode": "grpc-connecting",
      "toNode": "connect-complete",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": { "edgeType": "flow" }
    },
    {
      "id": "grpc-to-error",
      "fromNode": "grpc-connecting",
      "toNode": "connect-error",
      "fromSide": "right",
      "toSide": "left",
      "pv": { "edgeType": "error" }
    },
    {
      "id": "error-to-terminated",
      "fromNode": "connect-error",
      "toNode": "endpoint-terminated",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": { "edgeType": "error" }
    }
  ],
  "pv": {
    "name": "Remote Endpoint Connection",
    "version": "1.0.0",
    "markdown": ".principal-views/remote-endpoint/remote-endpoint.md",
    "edgeTypes": {
      "flow": {
        "style": "solid",

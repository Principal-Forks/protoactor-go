      "pv": {
        "status": "draft",
        "event": {
          "name": "remote.endpoint.connect.complete",
          "attributes": {
            "remote.address": {
              "type": "string",
              "description": "The remote address",
              "required": true
            },
            "duration.ms": {
              "type": "number",

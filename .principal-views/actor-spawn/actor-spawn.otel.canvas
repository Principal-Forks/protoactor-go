              "type": "string",
              "description": "The ID of the actor being spawned",
              "required": true
            },
            "actor.parent.id": {
              "type": "string",
              "description": "Parent actor ID (empty for root spawn)",
              "required": false,
              "display": false
            },
            "spawn.type": {
              "type": "string",
              "description": "Type of spawn: 'root' or 'child'",
              "required": true
            },
            "props.producer.type": {
              "type": "string",
              "description": "Type name of the actor producer",
              "required": false
            }
          }
        },
